# Deploy — generated frontend build served by FastAPI
frontend/dist/

# Encrypted transaction/rule store + console audit (never commit financial data)
backend/txn_data/
backend/console_history.log
backend/plaid_actuals.json

# Plaid pipeline — never commit transaction data, encrypted store, or intermediates
plaid_pipeline/data/
plaid_pipeline/*.parquet
plaid_pipeline/*.enc
plaid_pipeline/*.json
plaid_pipeline/__pycache__/
# Dump — drop zone for statements/exports to hand off. Keep the dir but never
# commit anything dropped into it (financial data). Only .gitkeep is tracked.
dump/*
!dump/.gitkeep

# Mailbox — dumped receipt-email samples used for parser development (real email
# content / financial data). Never commit; the subsystem stores creds in the
# Windows Credential Manager, not here.
backend/mailbox/_samples/

# Processed order documents (renamed + raw invoice PDFs, real financial data).
# Never commit; kept locally for provenance and the split pipeline.
processed_document/
